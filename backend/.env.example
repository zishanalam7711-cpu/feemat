# ===== FeeMat backend settings. Copy these names into Render > Environment. NEVER commit real values. =====

# --- already used by the app ---
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/
JWT_SECRET=put-a-long-random-string-here

# --- email (password reset OTP) ---
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=FeeMat

# ===================== AI AGENT (teacher only) =====================
AI_ENABLED=true
# Order the providers are tried in. FREE ones are always tried before PAID ones.
AI_PROVIDERS=gemini,groq,anthropic

# --- FREE provider 1: Google Gemini (AI Studio key). Free tier limits and model names change - check ai.google.dev/pricing ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_DAILY_CAP=15
# Free tiers may use your data to improve Google products, so this stays "shared" (false). Student data is never sent to it.
GEMINI_PRIVATE=false

# --- FREE provider 2: Groq (text only by default) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_DAILY_CAP=100
GROQ_PRIVATE=false

# --- PAID provider (used ONLY if AI_PAID_ENABLED=true and the monthly budget is above 0) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# price per 1 million tokens in USD - check the provider's pricing page and keep this updated
ANTHROPIC_PRICE_IN=0.10
ANTHROPIC_PRICE_OUT=0.50

# --- cost control ---
AI_PAID_ENABLED=false
AI_MONTHLY_BUDGET_USD=0
AI_DAILY_LIMIT_PER_TEACHER=40
AI_MINUTE_LIMIT_PER_TEACHER=8
AI_MAX_INPUT_CHARS=6000
AI_MAX_OUTPUT_TOKENS=900
AI_TIMEOUT_SEC=40
AI_REQUIRE_PRO=false

# --- files and privacy ---
AI_MAX_IMAGE_MB=6
AI_MAX_PDF_MB=8
AI_STORAGE_MB_PER_TEACHER=60
AI_FILE_RETENTION_DAYS=30
# 330 = India (UTC+5:30). Used for "today" and "this month".
AI_TZ_OFFSET_MIN=330
# Face matching for photo attendance. Leave false until you have reviewed consent, privacy law and accuracy (see AI_SETUP_HI.md).
AI_FACE_MATCH_ENABLED=false
